# Copy to .env and fill in — .env is gitignored and never read by the assistant.
# The CLI auto-loads .env from CWD or repo root on every run.

# OpenAI / Zen gateway — base must be .../v1 (code normalizes it if you omit /v1)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://opencode.ai/zen/go/v1

# Optional defaults for the CLI (uncomment to set)
# OPENAI_MODEL=gpt-5.6-luna
